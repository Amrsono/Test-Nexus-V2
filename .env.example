# Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your real .env file to source control.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/test_nexus?schema=public

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Subscriptions ────────────────────────────────────────────────────────────
SUBSCRIPTION_COST=100
VODAFONE_NUMBER=01xxxxxxxxx
PAYPAL_EMAIL=payments@example.com
PAYONEER_EMAIL=payments@example.com

# ─── Storage (optional — for logo/background uploads) ─────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
