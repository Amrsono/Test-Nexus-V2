{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...express].js": {
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...express]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
