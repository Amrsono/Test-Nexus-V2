{
  "name": "test-nexus",
  "version": "1.0.0",
  "description": "Premium Test Management Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=client && npm run test --workspace=server",
    "lint": "npm run lint --workspace=client",
    "postinstall": "cd server && npx prisma@5.22.0 generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "5.22.0"
  },
  "dependencies": {
    "puppeteer": "^24.43.0"
  }
}
